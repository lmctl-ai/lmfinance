# Finance-track additions (durable-memory/12-finance-track-additions.md): pinned closed-form values.
p = _lmcode_ cli="lmfinance";
market.set_date("2024-01-02");

# 1. number helpers
lmf.check(lmf.money(331000000.0 / 1331.0 / 100.0) == "2,486.85", "money 2,486.85");
lmf.check(lmf.money(0.0 - 1234567.891) == "-1,234,567.89", "money negative");
lmf.check(lmf.money(0.0 - 0.001) == "0.00", "money no negative zero");
lmf.assert_close(lmf.round(402.114803625378, 2), 402.11, 0.0000000001);
lmf.check(lmf.round(1331.0 / pow(1.1, 3.0), 2) == 1000.0, "999.9999999999997 rounds to 1000.00");
lmf.check(lmf.round(1.005, 2) == 1.01, "1.005 rounds half up as a decimal");
lmf.check(lmf.round(2.675, 2) == 2.68, "2.675 rounds half up as a decimal");
lmf.check(lmf.round(0.0 - 2.5, 0) == 0.0 - 3.0, "half goes away from zero");
lmf.check(lmf.fraction(7.142857142857143, 1000) == "50/7", "fraction 50/7");
lmf.check(lmf.fraction(10.0 / 21.0, 1000) == "10/21", "fraction 10/21");
lmf.check(lmf.fraction(0.0 - 0.5, 10) == "-1/2", "fraction negative");
lmf.check(lmf.fraction(3.0, 10) == "3", "fraction integer");
lmf.assert_close(lmf.log(1.1), 0.0953101798043249, 0.000000000000001);
lmf.assert_close(lmf.exp(lmf.log(2.0)), 2.0, 0.000000000000001);

# 4. a flat curve with a stated compounding; equivalent rates
let c10 = market.flat_curve_compounded(0.10, "annual");
lmf.assert_close(c10.discount(3.0), 0.751314800901578, 0.000000000000001);
lmf.check(lmf.round(1331.0 * c10.discount(3.0), 2) == 1000.0, "1331 discounts to 1000.00");
lmf.assert_close(market.flat_curve_compounded(0.10, "simple").discount(2.0), 1.0 / 1.2, 0.000000000000001);
lmf.assert_close(market.flat_curve_compounded(0.12, "semiannual").discount(1.0), 1.0 / 1.1236, 0.000000000000001);
lmf.assert_close(market.flat_curve_compounded(0.05, "continuous").discount(2.0), market.flat_curve(0.05).discount(2.0), 0.000000000000001);
lmf.assert_close(market.equivalent_rate(0.12, "semiannual", "annual"), 0.1236, 0.000000000000001);
lmf.assert_close(market.equivalent_rate(0.1236, "annual", "semiannual"), 0.12, 0.000000000000001);

# 7. present value of a list of cash flows
let ts = float_list(); ts.add(0.0); ts.add(1.0); ts.add(2.0);
let amts = float_list(); amts.add(0.0 - 1000.0); amts.add(605.0); amts.add(605.0);
lmf.assert_close(pricing.npv(market.flat_curve_compounded(0.10, "annual"), ts, amts), 50.0, 0.000000001);
let terms = pricing.pv_terms(market.flat_curve_compounded(0.10, "annual"), ts, amts);
lmf.assert_close(terms.at(1), 550.0, 0.000000001);
lmf.assert_close(terms.at(2), 500.0, 0.000000001);

# 17. annuities
lmf.assert_close(pricing.annuity_pv(1000.0, 0.10, 3), 2486.85199098422, 0.00000001);
lmf.assert_close(pricing.annuity_fv(1000.0, 0.10, 3), 3310.0, 0.000000001);
lmf.assert_close(pricing.annuity_pv(100.0, 0.0, 4), 400.0, 0.000000001);
# the annuity is item 7 on a level leg
let lt = float_list(); lt.add(1.0); lt.add(2.0); lt.add(3.0);
let la = float_list(); la.add(1000.0); la.add(1000.0); la.add(1000.0);
lmf.assert_close(pricing.npv(c10, lt, la), pricing.annuity_pv(1000.0, 0.10, 3), 0.000000001);

# 20. loan payment and amortization
lmf.assert_close(pricing.loan_payment(1000.0, 0.10, 3), 402.114803625378, 0.000000001);
let pay = pricing.amortization(1000.0, 0.10, 3, "payment");
let intr = pricing.amortization(1000.0, 0.10, 3, "interest");
let prin = pricing.amortization(1000.0, 0.10, 3, "principal");
let bal = pricing.amortization(1000.0, 0.10, 3, "balance");
lmf.assert_close(pay.at(0), 402.11, 0.0000001);
lmf.assert_close(pay.at(2), 402.13, 0.0000001);
lmf.assert_close(intr.at(0), 100.0, 0.0000001);
lmf.assert_close(intr.at(1), 69.79, 0.0000001);
lmf.assert_close(intr.at(2), 36.56, 0.0000001);
lmf.assert_close(prin.at(0), 302.11, 0.0000001);
lmf.assert_close(prin.at(1), 332.32, 0.0000001);
lmf.assert_close(prin.at(2), 365.57, 0.0000001);
lmf.assert_close(bal.at(0), 697.89, 0.0000001);
lmf.assert_close(bal.at(1), 365.57, 0.0000001);
lmf.assert_close(bal.at(2), 0.0, 0.0000001);
lmf.assert_close(prin.at(0) + prin.at(1) + prin.at(2), 1000.0, 0.0000001);

# 5. a curve from discount factors (set the date to 2025-01-02: no leap day inside the next three years, so a bond's
# coupon dates fall exactly on the curve's whole-year nodes)
market.set_date("2025-01-02");
let dc = market.discount_curve().discount(1.0, 0.96).discount(2.0, 0.90).discount(3.0, 0.84).build();
lmf.assert_close(dc.discount(1.0), 0.96, 0.000000000001);
lmf.assert_close(dc.discount(2.0), 0.90, 0.000000000001);
lmf.assert_close(dc.discount(3.0), 0.84, 0.000000000001);
lmf.assert_close(dc.discount(0.0), 1.0, 0.000000000001);
lmf.assert_close(pricing.bond_clean_price(instrument.bond(100.0, 0.05, 3.0, 1), dc), 97.5, 0.000000001);
let t3 = float_list(); t3.add(1.0); t3.add(2.0); t3.add(3.0);
let a3 = float_list(); a3.add(20.0); a3.add(30.0); a3.add(40.0);
lmf.assert_close(pricing.npv(dc, t3, a3), 79.8, 0.000000001);

# 14. zero and forward rates with a stated compounding
lmf.assert_close(dc.forward_rate(1.0, 2.0, "simple"), 1.0 / 15.0, 0.000000000001);
lmf.assert_close(dc.zero_rate(2.0, "annual"), 0.0540925534, 0.0000000001);
lmf.assert_close(dc.zero_rate(2.0, "continuous"), dc.zero(2.0), 0.000000000001);
lmf.assert_close(dc.forward_rate(1.0, 2.0, "continuous"), dc.forward(1.0, 2.0), 0.000000000001);
market.set_date("2024-01-02");

# 8. payoff at expiry
lmf.assert_close(instrument.european_call(100.0, 1.0).payoff(120.0), 20.0, 0.000000000001);
lmf.assert_close(instrument.european_call(100.0, 1.0).payoff(100.0), 0.0, 0.000000000001);
lmf.assert_close(instrument.european_put(100.0, 1.0).payoff(80.0), 20.0, 0.000000000001);
lmf.assert_close(instrument.european_put(100.0, 1.0).payoff(120.0), 0.0, 0.000000000001);
lmf.assert_close(instrument.forward(105.0, 1.0).payoff(90.0), 0.0 - 15.0, 0.000000000001);
lmf.assert_close(instrument.forward(105.0, 1.0).payoff(120.0), 15.0, 0.000000000001);

# 10. strategy of weighted legs
let spread = instrument.strategy().add(instrument.european_call(100.0, 1.0), 1.0).add(instrument.european_call(110.0, 1.0), 0.0 - 1.0);
lmf.assert_close(spread.payoff(110.0), 10.0, 0.000000000001);
lmf.assert_close(spread.payoff(80.0), 0.0, 0.000000000001);
lmf.assert_close(spread.payoff(130.0), 10.0, 0.000000000001);
let longcall = instrument.strategy().add(instrument.european_call(100.0, 1.0), 1.0);
lmf.assert_close(longcall.profit(120.0, 5.0), 15.0, 0.000000000001);
lmf.assert_close(longcall.profit(80.0, 5.0), 0.0 - 5.0, 0.000000000001);
let straddle = instrument.strategy().add(instrument.european_call(100.0, 1.0), 1.0).add(instrument.european_put(100.0, 1.0), 1.0);
let grid = straddle.payoffs(80.0, 120.0, 5);
lmf.check(grid.len() == 5, "grid has 5 points");
lmf.assert_close(grid.at(0), 20.0, 0.000000000001);
lmf.assert_close(grid.at(2), 0.0, 0.000000000001);
lmf.assert_close(grid.at(4), 20.0, 0.000000000001);

# 15. perpetuity
lmf.assert_close(pricing.perpetuity(100.0, 0.10, 0.04), 5200.0 / 3.0, 0.000000001);
lmf.assert_close(pricing.perpetuity(100.0, 0.10, 0.0), 1000.0, 0.000000001);
# two-stage: flows 100, 110 at t=1,2 and a 3% perpetuity after: 100/1.1 + 110/1.21 + 110*1.03/0.07/1.21
let fl = float_list(); fl.add(100.0); fl.add(110.0);
lmf.assert_close(pricing.dcf_two_stage(0.10, fl, 0.03), 100.0 / 1.1 + 110.0 / 1.21 + 110.0 * 1.03 / 0.07 / 1.21, 0.000000001);

# 16. forward price with carry; daily settlement
let c5 = market.flat_curve_compounded(0.05, "annual");
lmf.assert_close(pricing.forward_price(100.0, c5, 1.0, 0.0, 0.0), 105.0, 0.000000001);
lmf.assert_close(pricing.forward_price(100.0, c5, 1.0, 3.0, 0.0), 102.0, 0.000000001);
lmf.assert_close(pricing.forward_price(100.0, c5, 1.0, 0.0, 2.0), 107.0, 0.000000001);
let st = float_list(); st.add(107.0); st.add(104.0); st.add(106.0);
let mtm = risk.mark_to_market(105.0, st);
lmf.assert_close(mtm.at(0), 2.0, 0.000000000001);
lmf.assert_close(mtm.at(1), 0.0 - 3.0, 0.000000000001);
lmf.assert_close(mtm.at(2), 2.0, 0.000000000001);

# 2. explicit binomial tree (simple rate per step)
let tr = model.binomial_tree(100.0, 1.2, 0.9, 0.05, 2);
lmf.assert_close(tr.q(), 0.5, 0.000000000001);
lmf.check(tr.steps() == 2, "two steps");
lmf.assert_close(tr.discount(), 1.0 / 1.05, 0.000000000001);
lmf.assert_close(tr.stock(2, 2), 144.0, 0.000000000001);
lmf.assert_close(tr.stock(2, 1), 108.0, 0.000000000001);
lmf.assert_close(tr.stock(2, 0), 81.0, 0.000000000001);
lmf.assert_close(tr.prob(2, 1), 0.5, 0.000000000001);
lmf.check(tr.is_arbitrage_free(), "100, 1.2, 0.9 at 5% has no arbitrage");
let one = model.binomial_tree(100.0, 1.2, 0.9, 0.05, 1);
lmf.assert_close(one.state_price(1, 1), 10.0 / 21.0, 0.000000000001);
lmf.assert_close(one.state_price(1, 0), 10.0 / 21.0, 0.000000000001);
lmf.check(!model.binomial_tree(100.0, 1.2, 0.9, 0.25, 1).is_arbitrage_free(), "25% is above the up factor");

# 3. pricing on the explicit tree
let ec = pricing.tree_price(instrument.european_call(105.0, 1.0), tr);
lmf.assert_close(ec.price(), 500.0 / 49.0, 0.000000000001);
lmf.assert_close(ec.delta(0, 0), 13.0 / 21.0, 0.000000000001);
lmf.assert_close(ec.gamma(0, 0), 4.0 / 135.0, 0.000000000001);
lmf.assert_close(ec.value(2, 2), 39.0, 0.000000000001);
let ap = pricing.tree_price(instrument.american_put(105.0, 1.0), tr);
lmf.assert_close(ap.price(), 50.0 / 7.0, 0.000000000001);
lmf.assert_close(ap.intrinsic(1, 0), 15.0, 0.000000000001);
lmf.assert_close(ap.continuation(1, 0), 80.0 / 7.0, 0.000000000001);
lmf.check(ap.exercised(1, 0), "the down node of the American put is exercised");
lmf.check(!ap.exercised(0, 0), "the root is not exercised");
lmf.assert_close(pricing.tree_price(instrument.european_put(105.0, 1.0), tr).price(), 800.0 / 147.0, 0.000000000001);
let oc = pricing.tree_price(instrument.european_call(105.0, 1.0), one);
lmf.assert_close(oc.price(), 50.0 / 7.0, 0.000000000001);
lmf.assert_close(oc.delta(0, 0), 0.5, 0.000000000001);
lmf.assert_close(oc.bond(0, 0), 0.0 - 300.0 / 7.0, 0.000000000001);
lmf.assert_close(oc.delta(0, 0) * 100.0 + oc.bond(0, 0), oc.price(), 0.000000000001);

# 6. portfolio mean, variance and volatility
let w2 = float_list(); w2.add(0.5); w2.add(0.5);
let v2 = float_list(); v2.add(0.20); v2.add(0.10);
let i2 = float_list(); i2.add(1.0); i2.add(0.0); i2.add(0.0); i2.add(1.0);
let r2 = float_list(); r2.add(0.10); r2.add(0.06);
lmf.assert_close(risk.portfolio_variance(w2, v2, i2), 0.0125, 0.000000000000001);
lmf.assert_close(risk.portfolio_vol(w2, v2, i2), 0.111803399, 0.000000001);
lmf.assert_close(risk.portfolio_return(w2, r2), 0.08, 0.000000000000001);
let m2 = float_list(); m2.add(1.0); m2.add(0.0 - 1.0); m2.add(0.0 - 1.0); m2.add(1.0);
lmf.assert_close(risk.portfolio_variance(w2, v2, m2), 0.0025, 0.000000000000001);

# 11. minimum-variance and tangency weights
let mv0 = risk.min_variance_weights(v2, i2);
lmf.assert_close(mv0.at(0), 0.2, 0.000000000000001);
lmf.assert_close(mv0.at(1), 0.8, 0.000000000000001);
let mv1 = risk.min_variance_weights(v2, m2);
lmf.assert_close(mv1.at(0), 1.0 / 3.0, 0.000000000000001);
lmf.assert_close(mv1.at(1), 2.0 / 3.0, 0.000000000000001);
lmf.assert_close(risk.portfolio_variance(mv1, v2, m2), 0.0, 0.000000000000001);
let tg = risk.tangency_weights(r2, v2, i2, 0.04);
lmf.assert_close(tg.at(0), 3.0 / 7.0, 0.000000000000001);
lmf.assert_close(tg.at(1), 4.0 / 7.0, 0.000000000000001);
let v3 = float_list(); v3.add(0.10); v3.add(0.10); v3.add(0.10);
let i3 = float_list(); i3.add(1.0); i3.add(0.0); i3.add(0.0); i3.add(0.0); i3.add(1.0); i3.add(0.0); i3.add(0.0); i3.add(0.0); i3.add(1.0);
let mv3 = risk.min_variance_weights(v3, i3);
lmf.assert_close(mv3.at(0), 1.0 / 3.0, 0.000000000000001);
lmf.assert_close(mv3.at(2), 1.0 / 3.0, 0.000000000000001);
let r3 = float_list(); r3.add(0.08); r3.add(0.06); r3.add(0.04);
let tg3 = risk.tangency_weights(r3, v3, i3, 0.02);
lmf.assert_close(tg3.at(0), 0.5, 0.000000000000001);
lmf.assert_close(tg3.at(1), 1.0 / 3.0, 0.000000000000001);
lmf.assert_close(tg3.at(2), 1.0 / 6.0, 0.000000000000001);

# 9. discrete loss distribution
let ls = float_list(); ls.add(0.0 - 100.0); ls.add(0.0); ls.add(200.0); ls.add(500.0); ls.add(1500.0);
let ps = float_list(); ps.add(0.60); ps.add(0.20); ps.add(0.15); ps.add(0.02); ps.add(0.03);
let ld = risk.loss_distribution(ls, ps);
lmf.assert_close(ld.cdf(200.0), 0.95, 0.000000000001);
lmf.assert_close(ld.var(0.95), 200.0, 0.000000000001);
lmf.assert_close(ld.var(0.99), 1500.0, 0.000000000001);
lmf.assert_close(ld.es(0.95), 1100.0, 0.000000001);
lmf.assert_close(ld.mean(), 0.0 - 60.0 + 30.0 + 10.0 + 45.0, 0.000000001);
let ls2 = float_list(); ls2.add(0.0 - 100.0); ls2.add(0.0); ls2.add(200.0); ls2.add(500.0); ls2.add(3000.0);
lmf.assert_close(risk.loss_distribution(ls2, ps).es(0.95), 2000.0, 0.000000001);

# 12-13. a swap with textbook conventions, its legs and flows (curve from discount factors)
let sw = instrument.swap_simple(100.0, 0.05, 3.0, 1);
lmf.assert_close(pricing.swap_npv(sw, dc), 2.5, 0.000000000001);
lmf.assert_close(pricing.swap_par_rate(sw, dc), 8.0 / 135.0, 0.000000000001);
lmf.assert_close(pricing.swap_annuity(sw, dc), 100.0 * 2.7, 0.000000000001);
lmf.assert_close(pricing.swap_npv(instrument.swap_simple(100.0, 0.05, 3.0, 1).receiver(), dc), 0.0 - 2.5, 0.000000000001);
lmf.assert_close(pricing.swap_fixed_leg_npv(sw, dc), 13.5, 0.000000000001);
lmf.assert_close(pricing.swap_float_leg_npv(sw, dc), 16.0, 0.000000000001);
let ff = pricing.swap_flows(sw, dc, "float");
lmf.assert_close(ff.at(0), 100.0 / 24.0, 0.000000000001);
lmf.assert_close(ff.at(1), 100.0 / 15.0, 0.000000000001);
lmf.assert_close(ff.at(2), 100.0 / 14.0, 0.000000000001);
let nf = pricing.swap_flows(sw, dc, "net");
lmf.assert_close(nf.at(0), 100.0 / 24.0 - 5.0, 0.000000000001);
lmf.assert_close(nf.at(1), 100.0 / 15.0 - 5.0, 0.000000000001);
lmf.assert_close(nf.at(2), 100.0 / 14.0 - 5.0, 0.000000000001);
lmf.assert_close(pricing.swap_flows(sw, dc, "fixed").at(1), 5.0, 0.000000000001);
# a struck-at-par swap is worth nothing, and the par rate is the par yield of item 19
lmf.assert_close(pricing.swap_npv(instrument.swap_simple(100.0, 8.0 / 135.0, 3.0, 1), dc), 0.0, 0.000000000001);
lmf.assert_close(pricing.par_yield(dc, 3.0, 1), 8.0 / 135.0, 0.000000000001);
# semiannual: par rate = 2 (1 - D(3)) / sum of D at the half years, on a flat 5% semiannual curve it is 5%
let f5 = market.flat_curve_compounded(0.05, "semiannual");
lmf.assert_close(pricing.swap_par_rate(instrument.swap_simple(100.0, 0.05, 2.0, 2), f5), 0.05, 0.000000000001);
lmf.assert_close(pricing.par_yield(f5, 2.0, 2), 0.05, 0.000000000001);
lmf.check(risk.swap_dv01(sw, dc) > 0.0, "a payer swap gains when rates rise");

# 18. bond cash flows and a bond with an issue date
let bt = pricing.bond_cashflow_times(instrument.bond(1000.0, 0.10, 3.0, 1));
let ba = pricing.bond_cashflow_amounts(instrument.bond(1000.0, 0.10, 3.0, 1));
lmf.check(bt.len() == 3 && ba.len() == 3, "three flows");
lmf.assert_close(bt.at(0), 1.0, 0.000000000001);
lmf.assert_close(bt.at(2), 3.0, 0.000000000001);
lmf.assert_close(ba.at(0), 100.0, 0.000000000001);
lmf.assert_close(ba.at(1), 100.0, 0.000000000001);
lmf.assert_close(ba.at(2), 1100.0, 0.000000000001);
market.set_date("2024-05-01");
let bd = instrument.bond_dated(1000.0, 0.10, "2024-01-01", "2027-01-01", 2);
# accrued is per 100 face like the clean price: 120/180 of the 5.00 coupon; on a face of 1000 that is 33.33
lmf.assert_close(pricing.bond_accrued(bd), 10.0 / 3.0, 0.000000001);
lmf.assert_close(980.0 + 10.0 * pricing.bond_accrued(bd), 1013.33333333333, 0.00000001);
let dt = pricing.bond_cashflow_times(bd);
let da = pricing.bond_cashflow_amounts(bd);
lmf.check(dt.len() == 6, "six remaining flows");
lmf.assert_close(dt.at(0), 60.0 / 360.0, 0.000000000001);
lmf.assert_close(da.at(0), 50.0, 0.000000000001);
lmf.assert_close(da.at(5), 1050.0, 0.000000000001);
lmf.assert_close(pricing.bond_accrued(instrument.bond(1000.0, 0.10, 3.0, 2)), 0.0, 0.000000000001);
market.set_date("2024-01-02");

# 19. par yield and bootstrap from bond prices (2025-01-02: no leap day over three years, coupon dates on the nodes)
market.set_date("2025-01-02");
let bs = market.bootstrap_curve().bond(1.0, 0.05, 100.80).bond(2.0, 0.05, 99.30).bond(3.0, 0.05, 97.50).build();
lmf.assert_close(bs.discount(1.0), 0.96, 0.000000001);
lmf.assert_close(bs.discount(2.0), 0.90, 0.000000001);
lmf.assert_close(bs.discount(3.0), 0.84, 0.000000001);
lmf.assert_close(pricing.par_yield(bs, 3.0, 1), 8.0 / 135.0, 0.000000001);
market.set_date("2024-01-02");
end _lmcode_
r = run_lmcode(p);
println(json_stringify(r));
require(r.ok, "finance_additions failed");
