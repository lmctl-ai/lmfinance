# Parametric value at risk and expected shortfall under normal returns.
out = ARGV.len() > 0 ? ARGV[0] : "build/risk.dslb";
p = _lmcode_ cli="lmfinance";
# 1% daily vol, 1 day, 99%: VaR = 2.3263 sigma, ES = 2.6652 sigma
let annual = 0.01 * sqrt(252.0);
lmf.assert_close(risk.var_normal(1000000.0, annual, 0.99, 1.0), 23263.48, 0.01);
lmf.assert_close(risk.es_normal(1000000.0, annual, 0.99, 1.0), 26652.14, 0.05);
# 95%: 1.6449 sigma
lmf.assert_close(risk.var_normal(1000000.0, annual, 0.95, 1.0), 16448.54, 0.01);
# square-root-of-time scaling: 10 days = sqrt(10) times 1 day
lmf.assert_close(risk.var_normal(1000000.0, annual, 0.99, 10.0), 23263.48 * sqrt(10.0), 0.05);
lmf.check(risk.es_normal(1000000.0, annual, 0.99, 1.0) > risk.var_normal(1000000.0, annual, 0.99, 1.0), "ES exceeds VaR");
end _lmcode_
savedsl(p, out);
