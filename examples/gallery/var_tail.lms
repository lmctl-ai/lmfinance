# Value at risk and expected shortfall of a 1 million position with 20% annual volatility over 10 days (normal returns):
# the 99% VaR is the loss exceeded 1% of the time, the shortfall is the average loss in that tail.
# lmfinance computes VaR/ES with QuantLib's normal quantile; lmplot draws images/var_tail.png.
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmfinance" install="github:lmctl-ai/lmfinance@latest";
let value = 1000000.0;
let vol = 0.2;
let days = 10.0;
let var99 = risk.var_normal(value, vol, 0.99, days);
let es99 = risk.es_normal(value, vol, 0.99, days);
let sigma = value * vol * sqrt(days / 252.0);
lmf.print("sigma " + str(sigma) + ", VaR99 " + str(var99) + ", ES99 " + str(es99));
# VaR = 2.3263 sigma, ES = 2.6652 sigma
lmf.assert_close(var99 / sigma, 2.326348, 0.00001);
lmf.assert_close(es99 / sigma, 2.665214, 0.00001);
let pdf = "";
let tail = "";
for (i in range(0, 301)) {
  let x = -4.0 * sigma + 8.0 * sigma * float(i) / 300.0;
  let d = pow(2.718281828459045, -0.5 * (x / sigma) * (x / sigma)) / (sigma * 2.5066282746310002);
  pdf = pdf + str(x / 1000.0) + " " + str(d * 1000.0) + "\n";
  if (x <= -var99) { tail = tail + str(x / 1000.0) + " " + str(d * 1000.0) + "\n"; }
}
lmf.save_text("data/var_pdf.csv", pdf);
lmf.save_text("data/var_tail.csv", tail);
lmf.save_text("data/var_marks.csv", str(-var99 / 1000.0) + " " + str(-es99 / 1000.0) + "\n");
end _lmcode_
savedsl(sim, "data/var_tail-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/var_tail-sim.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/var_tail.png", 900, 560);
# Read numeric columns directly, before plot ranges filter the data.
plot.cmd("stats 'data/var_marks.csv' using 1 nooutput; v = STATS_min");
plot.cmd("stats 'data/var_marks.csv' using 2 nooutput; e = STATS_min");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'; set key top left box opaque");
plot.cmd("set title '10-day profit and loss of a 1 million position: 99% VaR and expected shortfall'");
plot.cmd("set xlabel 'profit and loss [thousand]'; set ylabel 'density'; set yrange [0:*]");
plot.cmd("set arrow 1 from v, graph 0 to v, graph 0.7 nohead lw 3 lc rgb '#d62728'; set arrow 2 from e, graph 0 to e, graph 0.45 nohead lw 3 lc rgb '#ff7f0e'");
plot.cmd("set label 1 sprintf('VaR 99%% = %.0f', -v) at v-3, graph 0.74 right tc rgb '#d62728'; set label 2 sprintf('ES 99%% = %.0f', -e) at e-3, graph 0.5 right tc rgb '#ff7f0e'");
plot.cmd("plot 'data/var_tail.csv' u 1:2 w filledcurves y1=0 lc rgb '#f4b6b6' t 'worst 1%', 'data/var_pdf.csv' u 1:2 w l lw 3 lc rgb '#1f77b4' t 'normal P/L'");
plot.close();
end _lmcode_
savedsl(draw, "data/var_tail-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/var_tail-draw.dslb;
assert(r.code == 0);
println("wrote images/var_tail.png");
