# One call, four ways: error of the binomial tree and the finite-difference grid against the Black-Scholes closed form
# 10.4506 as the discretization is refined, and the Monte Carlo error shrinking as 1/sqrt(N) (seeded).
# lmfinance prices, lmplot draws images/engine_convergence.png.
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmfinance" install="github:lmctl-ai/lmfinance@latest";
let m = model.black_scholes(100.0, 0.05, 0.0, 0.2);
let call = instrument.european_call(100.0, 1.0);
let exact = pricing.price(call, m, pricing.analytic()).price();
lmf.assert_close(exact, 10.4506, 0.00005);
let tree = "";
let fd = "";
let mc = "";
let n = 10;
for (k in range(0, 9)) {
  let e1 = abs(pricing.price(call, m, pricing.binomial(n)).price() - exact);
  tree = tree + str(n) + " " + str(e1) + "\n";
  let e2 = abs(pricing.price(call, m, pricing.finite_diff(n, 2 * n)).price() - exact);
  fd = fd + str(n) + " " + str(e2) + "\n";
  n = n * 2;
}
let paths = 1000;
for (k in range(0, 8)) {
  let r = pricing.price(call, m, pricing.monte_carlo(paths, 42));
  mc = mc + str(paths) + " " + str(abs(r.price() - exact)) + " " + str(r.stderr()) + "\n";
  paths = paths * 4;
}
lmf.save_text("data/conv_tree.csv", tree);
lmf.save_text("data/conv_fd.csv", fd);
lmf.save_text("data/conv_mc.csv", mc);
# the tree at 2560 steps is within 1e-3 of the closed form
lmf.assert_close(pricing.price(call, m, pricing.binomial(2560)).price(), exact, 0.001);
end _lmcode_
savedsl(sim, "data/engine_convergence-sim.dslb");
r = system ${dsl_cli(sim)} --lmcode data/engine_convergence-sim.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/engine_convergence.png", 900, 600);
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'; set logscale xy; set format y '10^{%L}'; set format x '10^{%L}'");
plot.cmd("set title 'Pricing error of one call against the closed form'");
plot.cmd("set xlabel 'tree steps / time steps / Monte Carlo paths'; set ylabel '|price - 10.4506|'; set key top right box opaque");
plot.cmd("plot 'data/conv_tree.csv' u 1:2 w lp lw 2 pt 7 lc rgb '#1f77b4' t 'binomial tree (CRR)', 'data/conv_fd.csv' u 1:2 w lp lw 2 pt 5 lc rgb '#2ca02c' t 'finite differences (n x 2n grid)', 'data/conv_mc.csv' u 1:2 w lp lw 2 pt 9 lc rgb '#d62728' t 'Monte Carlo, seed 42', '' u 1:3 w l lw 2 dt 2 lc rgb '#d62728' t 'MC standard error'");
plot.close();
end _lmcode_
savedsl(draw, "data/engine_convergence-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode data/engine_convergence-draw.dslb;
assert(r.code == 0);
println("wrote images/engine_convergence.png");
