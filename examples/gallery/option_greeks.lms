# Price, delta and gamma of an at-the-money call as the spot moves.
# Two hosts in one script: lmfinance computes and writes a CSV, lmplot (gnuplot in a static binary) draws it.
# Needs lmplot on PATH or installable; the PNG lands in images/
mkdir("images");
mkdir("data");
calc = _lmcode_ cli="lmfinance" install="github:lmctl-ai/lmfinance@latest";

let m = model.black_scholes(100.0, 0.05, 0.0, 0.2);
let call = instrument.european_call(100.0, 1.0);
risk.save_profile(call, m, pricing.analytic(), 60.0, 140.0, 161, "data/option_greeks.csv");
end _lmcode_
savedsl(calc, "data/option_greeks-calc.dslb");
r = system ${dsl_cli(calc)} --lmcode data/option_greeks-calc.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/option_greeks.png", 900, 600);
plot.cmd("set border 11; set grid lc rgb '#dddddd'");
plot.cmd("set title 'European call (strike 100, 1 year, 20% vol): price and delta'");
plot.cmd("set xlabel 'spot'");
plot.cmd("set ylabel 'price'");
plot.cmd("set y2label 'delta'");
plot.cmd("set y2tics");
plot.cmd("set ytics nomirror");
plot.cmd("set key top left box opaque");
plot.cmd("plot 'data/option_greeks.csv' using 1:2 with lines lw 3 lc rgb '#d62728' title 'price (left)', '' using 1:3 axes x1y2 with lines lw 3 lc rgb '#1f77b4' title 'delta (right)'");
plot.close();
end _lmcode_
savedsl(draw, "data/option_greeks-draw.dslb");
r = system ${dsl_cli(draw)} --lmcode data/option_greeks-draw.dslb;
assert(r.code == 0);
println("wrote images/option_greeks.png");
