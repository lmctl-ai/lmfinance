# Early exercise: an American put is worth more than its European twin, and never less than its intrinsic value max(K - S, 0).
# Deep in the money the holder exercises at once (the value hugs the payoff line); the gap is the early-exercise premium.
# lmfinance prices (CRR tree with 800 steps), lmplot draws images/american_put.png.
mkdir("images");
mkdir("data");
sim = _dsl_ cli="lmfinance" install="github:lmctl-ai/lmfinance@latest";
let rows = "";
for (i in range(0, 61)) {
  let s = 60.0 + float(i) * 1.5;
  let m = model.black_scholes(s, 0.05, 0.0, 0.2);
  let am = pricing.price(instrument.american_put(100.0, 1.0), m, pricing.binomial(800)).price();
  let eu = pricing.price(instrument.european_put(100.0, 1.0), m, pricing.analytic()).price();
  lmf.check(am >= eu - 0.000001, "American value is at least the European value");
  lmf.check(am >= max(100.0 - s, 0.0) - 0.000001, "American value is at least the intrinsic value");
  rows = rows + str(s) + " " + str(am) + " " + str(eu) + " " + str(am - eu) + "\n";
}
lmf.save_text("data/american_put.csv", rows);
# at S = K the textbook American put is 6.09 and the European put 5.5735
let atm = model.black_scholes(100.0, 0.05, 0.0, 0.2);
lmf.assert_close(pricing.price(instrument.american_put(100.0, 1.0), atm, pricing.binomial(800)).price(), 6.0903, 0.003);
lmf.assert_close(pricing.price(instrument.european_put(100.0, 1.0), atm, pricing.analytic()).price(), 5.5735, 0.0001);
end _dsl_
savedsl(sim, "data/american_put-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/american_put-sim.dslb;
assert(r.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/american_put.png", 900, 600);
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'; set key top right box opaque");
plot.cmd("set title 'American vs European put (K = 100, r = 5%, vol = 20%, 1 year)'");
plot.cmd("set xlabel 'spot S'; set ylabel 'put value'; set xrange [60:150]; set yrange [0:42]");
plot.cmd("plot 'data/american_put.csv' u 1:2:3 w filledcurves lc rgb '#f6d5d5' t 'early-exercise premium', '' u 1:2 w l lw 3 lc rgb '#d62728' t 'American (binomial 800)', '' u 1:3 w l lw 3 lc rgb '#1f77b4' t 'European (closed form)', (x < 100 ? 100 - x : 0) w l lw 2 dt 2 lc rgb 'black' t 'intrinsic value'");
plot.close();
end _dsl_
savedsl(draw, "data/american_put-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/american_put-draw.dslb;
assert(r.code == 0);
println("wrote images/american_put.png");
