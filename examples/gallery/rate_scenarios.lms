# Parallel rate shocks on a bootstrapped curve: a 10-year 4.5% bond gains more when rates fall than it loses when they rise
# (convexity), while a 5-year payer swap is nearly linear in the shift and changes sign: its DV01 is the slope at zero.
# lmfinance bootstraps the curve and reprices, lmplot draws images/rate_scenarios.png.
mkdir("images");
mkdir("data");
sim = _lmcode_ cli="lmfinance" install="github:lmctl-ai/lmfinance@latest";
market.set_date("2024-01-02");
let curve = market.bootstrap_curve().deposit("3M", 0.0300).deposit("6M", 0.0310)
  .swap("2Y", 0.0350).swap("5Y", 0.0400).swap("10Y", 0.0420).swap("30Y", 0.0410).build();
let bond = instrument.bond(1000000.0, 0.045, 10.0, 2);
let swap = instrument.swap(10000000.0, 0.04, 5.0);
let base_bond = pricing.bond_npv(bond, curve);
let base_swap = pricing.swap_npv(swap, curve);
# the curve reprices its own 5-year swap rate
lmf.assert_close(pricing.swap_par_rate(instrument.swap(1.0, 0.04, 5.0), curve), 0.04, 0.0000001);
lmf.assert_close(base_swap, 0.0, 0.01);
let rows = "";
for (i in range(0, 41)) {
  let shift = -0.02 + 0.001 * float(i);
  let c = curve.bumped(shift);
  rows = rows + str(shift * 10000.0) + " " + str((pricing.bond_npv(bond, c) - base_bond) / 1000.0) + " " + str((pricing.swap_npv(swap, c) - base_swap) / 1000.0) + "\n";
}
lmf.save_text("data/rate_scenarios.csv", rows);
let up = pricing.bond_npv(bond, curve.bumped(0.01)) - base_bond;
let down = pricing.bond_npv(bond, curve.bumped(-0.01)) - base_bond;
lmf.print("bond P/L for +/-100bp: " + str(up) + " / " + str(down));
# convexity: the gain from -100bp exceeds the loss from +100bp
lmf.check(down > -up, "bond gains more than it loses");
# DV01 (the slope at zero) agrees with a 1bp central difference of the scenarios
lmf.assert_close(risk.bond_dv01(bond, curve), (pricing.bond_npv(bond, curve.bumped(-0.0001)) - pricing.bond_npv(bond, curve.bumped(0.0001))) / 2.0, 0.000001);
end _lmcode_
savedsl(sim, "data/rate_scenarios-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/rate_scenarios-sim.dslb;
assert(r.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/rate_scenarios.png", 900, 560);
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'; set key top left box opaque; set zeroaxis");
plot.cmd("set title 'Parallel shifts of the zero curve: P/L of a bond and of a payer swap'");
plot.cmd("set xlabel 'curve shift [bp]'; set ylabel 'P/L [thousand]'");
plot.cmd("plot 'data/rate_scenarios.csv' u 1:2 w l lw 3 lc rgb '#1f77b4' t '10y 4.5% bond, 1 million face', '' u 1:3 w l lw 3 lc rgb '#d62728' t '5y payer swap, 10 million notional'");
plot.close();
end _lmcode_
savedsl(draw, "data/rate_scenarios-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/rate_scenarios-draw.dslb;
assert(r.code == 0);
println("wrote images/rate_scenarios.png");
