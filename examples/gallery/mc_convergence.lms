# Monte Carlo pricing with a seed: the estimate of the call value wanders inside its own error bar, and the bar shrinks
# as 1/sqrt(N). Every point is reproducible (seed 7). lmfinance prices, lmplot draws images/mc_convergence.png.
mkdir("images");
mkdir("data");
sim = _dsl_ cli="lmfinance" install="github:lmctl-ai/lmfinance@latest";
let m = model.black_scholes(100.0, 0.05, 0.0, 0.2);
let call = instrument.european_call(100.0, 1.0);
let exact = pricing.price(call, m, pricing.analytic()).price();
lmf.assert_close(exact, 10.4506, 0.00005);
let rows = "";
let paths = 500;
let inside = 0;
for (k in range(0, 8)) {
  let r = pricing.price(call, m, pricing.monte_carlo(paths, 7));
  rows = rows + str(paths) + " " + str(r.price()) + " " + str(r.stderr()) + "\n";
  if (abs(r.price() - exact) < 3.0 * r.stderr()) { inside = inside + 1; }
  paths = paths * 4;
}
lmf.save_text("data/mc_estimates.csv", rows);
lmf.save_text("data/mc_exact.csv", str(exact) + "\n");
# the same seed gives the same estimate; seven of the eight estimates are within 3 standard errors
lmf.assert_close(pricing.price(call, m, pricing.monte_carlo(4000, 7)).price(), pricing.price(call, m, pricing.monte_carlo(4000, 7)).price(), 0.0);
lmf.check(inside >= 7, "seven of eight estimates within 3 standard errors");
end _dsl_
savedsl(sim, "data/mc_convergence-sim.dslb");
r = system ${dsl_cli(sim)} --dsl data/mc_convergence-sim.dslb;
assert(r.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/mc_convergence.png", 900, 560);
# Read before plot ranges/log scales filter the data.
plot.cmd("stats 'data/mc_exact.csv' using 1 nooutput; exact = STATS_min");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#dddddd'; set logscale x; set format x '10^{%L}'; set key bottom right box opaque");
plot.cmd("set title 'Monte Carlo estimate of a call value with 1 standard-error bars (seed 7)'");
plot.cmd("set xlabel 'paths'; set ylabel 'price'; set xrange [300:3e7]; set yrange [9.3:11.0]");
plot.cmd("plot exact w l lw 2 dt 2 lc rgb 'black' t 'closed form 10.4506', 'data/mc_estimates.csv' u 1:2:3 w yerrorbars pt 7 ps 1.4 lw 2 lc rgb '#d62728' t 'Monte Carlo'");
plot.close();
end _dsl_
savedsl(draw, "data/mc_convergence-draw.dslb");
r = system ${dsl_cli(draw)} --dsl data/mc_convergence-draw.dslb;
assert(r.code == 0);
println("wrote images/mc_convergence.png");
